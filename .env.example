TMDB_API_KEY=

GROQ_API_KEY=

OMDB_API_KEY=

YOUTUBE_API_KEY=

RAPIDAPI_KEY=

# Optional — 2-letter country for "where to watch" (default IN)
TMDB_REGION=IN

ADMIN_USERNAME=

# Optional — set a real secret for sessions in production
# SECRET_KEY=change-me

# --- Email (password resets + address confirmation) -------------------------
# Leave blank to disable email features. Example below is Gmail with an
# App Password (Google Account -> Security -> 2-Step Verification -> App
# passwords). SMTP_PASSWORD is the 16-char app password, NOT your login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
#
# What recipients SEE as the sender. SMTP_FROM_NAME is the display name shown in
# every inbox (defaults to "ScreamStream"). To keep your personal address out of
# the email entirely, set SMTP_FROM to a dedicated no-reply address — note that
# Gmail rewrites From to the authenticated account unless it's a verified
# "Send mail as" alias, so a true no-reply needs either a dedicated mailbox or a
# transactional provider (Brevo/Resend/Mailgun free tiers all allow this).
# SMTP_FROM_NAME=ScreamStream
# SMTP_FROM=noreply@yourdomain.com
# SMTP_REPLY_TO=noreply@yourdomain.com

# Required to authorize the nightly /cron/enrich job (self-invented secret).
# CRON_SECRET=



